# Optional. Copy to .env next to compose.yaml to override a setting. Unset, the image's defaults apply (Dockerfile).

# --- the knobs (README.md, "Knobs") ---------------------------------------------------------------------------------
# What to prioritize (README.md, "Pick what to prioritize"). speed: requests up to 262,144 tokens (the default).
# context: one request up to 700,018 tokens. quality: the same as speed (K2 is the one width that fits one box).
#TUNE=speed
# The KV pool in tokens, shared by the sessions (about 5 KB of memory a token), a multiple of 64.
#CAP=700032
# The longest single request, prompt and output together, at most CAP less the guard rows (and 1,048,576).
# Unset: by TUNE (262144, or 700018 with context). With a smaller CAP and TUNE=context, set it too.
#MAX_MODEL_LEN=262144
# 1: a request alone on the box drafts with the DFlash2 drafter, fetched from Hugging Face and converted on the first
# boot (its licence is CC BY-NC-ND 4.0). 0: MTP only, and the drafter is never fetched.
#DFLASH=1
# 0: this box alone. 1: register with the mentat cluster through the host's mentat daemon, in group GROUP.
#MENTAT=0
#GROUP=gr8-glm53f-1x

# --- host directories in place of the named volumes, each owned by uid 1000 ------------------------------------------
#MODEL_CACHE_DIR=/srv/glm53f/cache      # the model, about 85 GB, and the converted drafter
#PROMPT_CACHE_DIR=/srv/glm53f/prompts   # the prompt cache, up to 64 GB (kv-store.yaml)
#GR8_HOME_DIR=/srv/glm53f/home          # logs and state

# --- the image ---------------------------------------------------------------------------------------------------
# A pinned image in place of latest, e.g. ghcr.io/kindlingai/glm-5.3-flash-exlr8-1x-spark:sha-<commit>
#IMAGE=

# --- other -----------------------------------------------------------------------------------------------------------
# The release and the drafter, each pinned to a Hugging Face commit (https://huggingface.co/<org>/<repo>@<commit>).
# The image pins the commits measured in README.md; drop the @<commit> to follow the repo's main.
#MODEL=https://huggingface.co/kindlingai/glm-5.3-flash-exlr8-k2-k3-k4@867580abd28d142bb4c56218bb81a752b7dea988
#DRAFTER=https://huggingface.co/incoai/GLM-5.3-Flash-DFlash2@bf582e4eacc1810f76656d1811693ff6c6737d2a
# Sent only to Hugging Face, for a gated or private repo
#HF_TOKEN=
# Any other gr8 launcher option (gr8/KNOBS.md) works here too, as NAME=VALUE.
